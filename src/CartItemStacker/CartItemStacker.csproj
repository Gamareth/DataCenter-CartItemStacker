<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CartItemStacker</AssemblyName>
    <RootNamespace>CartItemStacker</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DataCenterGamePath Condition="'$(DataCenterGamePath)' == ''">$(DATA_CENTER_GAME_PATH)</DataCenterGamePath>
    <MelonLoaderManagedPath>$(DataCenterGamePath)\MelonLoader\net6</MelonLoaderManagedPath>
    <Il2CppAssemblyPath>$(DataCenterGamePath)\MelonLoader\Il2CppAssemblies</Il2CppAssemblyPath>
    <UpdaterPublishDirectory>$(MSBuildProjectDirectory)\obj\$(Configuration)\EmbeddedUpdater\</UpdaterPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" Exclude="CartStacker.Targets.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MelonLoaderManagedPath)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MelonLoaderManagedPath)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MelonLoaderManagedPath)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Il2CppAssemblyPath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Il2CppAssemblyPath)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2CppAssemblyPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Il2CppAssemblyPath)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Il2CppAssemblyPath)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppcom.rlabrecque.steamworks.net"><HintPath>$(Il2CppAssemblyPath)\Il2Cppcom.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CartItemStacker.Updater\CartItemStacker.Updater.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource
      Include="$(UpdaterPublishDirectory)CartItemStacker.Updater.dll"
      LogicalName="CartItemStacker.Updater.dll" />
    <EmbeddedResource
      Include="$(UpdaterPublishDirectory)CartItemStacker.Updater.deps.json"
      LogicalName="CartItemStacker.Updater.deps.json" />
    <EmbeddedResource
      Include="$(UpdaterPublishDirectory)CartItemStacker.Updater.runtimeconfig.json"
      LogicalName="CartItemStacker.Updater.runtimeconfig.json" />
  </ItemGroup>

  <Target Name="PublishEmbeddedUpdater" BeforeTargets="PrepareResources">
    <RemoveDir Directories="$(UpdaterPublishDirectory)" />
    <MSBuild
      Projects="..\CartItemStacker.Updater\CartItemStacker.Updater.csproj"
      Targets="Publish"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);SelfContained=false;UseAppHost=false;PublishSingleFile=false;DebugType=None;DebugSymbols=false;PublishDir=$(UpdaterPublishDirectory)" />
  </Target>

  <Target Name="ValidateDataCenterGamePath" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(DataCenterGamePath)' == ''"
      Text="Set DATA_CENTER_GAME_PATH or pass /p:DataCenterGamePath=... to the build." />
    <Error
      Condition="!Exists('$(Il2CppAssemblyPath)\Assembly-CSharp.dll')"
      Text="Data Center IL2CPP assemblies were not found. Run the game through MelonLoader once, then verify DataCenterGamePath." />
  </Target>
</Project>
